# Copy this file to `.env` and update the values before running the application.

########################################
# APPLICATION
########################################

NODE_ENV=development
PORT=5050
APP_URL=http://localhost:3000
API_URL=http://localhost:5050


########################################
# DATABASE
########################################

DATABASE_URL=postgresql://postgres:password@localhost:5432/pureastra
DIRECT_URL=postgresql://postgres:password@localhost:5432/pureastra


########################################
# REDIS (for queues / background jobs)
########################################

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
EMAIL_QUEUE_NAME=email
EMAIL_WORKER_CONCURRENCY=5


########################################
# AUTHENTICATION
########################################

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
BETTER_AUTH_SECRET=replace_with_a_long_random_secret_at_least_32_chars
BETTER_AUTH_URL=http://localhost:5050
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5050
AUTH_VERIFY_EMAIL_CALLBACK_URL=http://localhost:3000/auth/verify-email
AUTH_RESET_PASSWORD_CALLBACK_URL=http://localhost:3000/auth/reset-password
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret


########################################
# EMAIL (Zoho SMTP)
########################################

SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=support@pureastra.in
SMTP_PASS=your_email_password
SMTP_FROM="Pureastra <support@pureastra.in>"


########################################
# SELLER / SHIPPING LABELS
########################################

SELLER_NAME="Pureastra"
SELLER_ADDRESS="AP 11/32, KOCHUVEETIL, CHERIYAZHEKKAL, ALAPPAD, ADINAD, KOLLAM, KERALA, 690573, S V MARKET BO, KE, 690573"
SELLER_GSTIN=32JCSPB8732D1ZJ
SELLER_STATE="KERALA"
FLAT_SHIPPING_CHARGE_INCLUSIVE=49
SHIPPING_GST_RATE=18

# Frontend display config (must match backend shipping config)
NEXT_PUBLIC_FLAT_SHIPPING_CHARGE_INCLUSIVE=49
NEXT_PUBLIC_SHIPPING_GST_RATE=18


########################################
# FILE STORAGE (optional)
########################################

STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads


########################################
# THIRD PARTY SERVICES
########################################

CLOUDINARY_URL=your_cloudinary_url
STRIPE_SECRET_KEY=your_stripe_secret_key


########################################
# ANALYTICS / TRACKING
########################################

ANALYTICS_SECRET=analytics_secret_key


########################################
# ADMIN SETTINGS
########################################

ADMIN_EMAIL=admin@pureastra.in
ADMIN_PASSWORD=change_this_password
