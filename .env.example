# Copy this file to `.env` and update the values before running the application.

########################################
# APPLICATION
########################################

NODE_ENV=development
PORT=5000
APP_URL=http://localhost:3000
API_URL=http://localhost:5000


########################################
# DATABASE
########################################

DATABASE_URL=postgresql://postgres:password@localhost:5432/pureastra


########################################
# REDIS (for queues / background jobs)
########################################

REDIS_URL=redis://localhost:6379


########################################
# AUTHENTICATION
########################################

JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d


########################################
# EMAIL (Zoho SMTP)
########################################

SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_USER=support@pureastra.in
SMTP_PASS=your_email_password
SMTP_FROM="Pureastra <support@pureastra.in>"


########################################
# FILE STORAGE (optional)
########################################

STORAGE_PROVIDER=local
UPLOAD_PATH=./uploads


########################################
# THIRD PARTY SERVICES
########################################

CLOUDINARY_URL=your_cloudinary_url
STRIPE_SECRET_KEY=your_stripe_secret_key


########################################
# ANALYTICS / TRACKING
########################################

ANALYTICS_SECRET=analytics_secret_key


########################################
# ADMIN SETTINGS
########################################

ADMIN_EMAIL=admin@pureastra.in
ADMIN_PASSWORD=change_this_password