<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Shipping Labels</title>
  <style>
    @page {
      size: 105mm 148mm;
      margin: 0;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html,
    body {
      width: 105mm;
      min-height: 148mm;
      background: #fff;
      color: #000;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 12px;
      line-height: 1.35;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .label {
      width: 105mm;
      height: 148mm;
      padding: 12px;
      page-break-after: always;
      page-break-inside: avoid;
      overflow: hidden;
      background: #fff;
    }

    .label:last-child {
      page-break-after: auto;
    }

    .section {
      border-top: 1px solid #000;
      padding: 8px 0;
    }

    .bold {
      font-weight: bold;
    }

    .name {
      font-size: 16px;
      font-weight: bold;
      line-height: 1.2;
      overflow-wrap: anywhere;
    }

    .pincode {
      font-size: 20px;
      font-weight: bold;
      line-height: 1.2;
      margin-top: 4px;
    }

    .barcode {
      text-align: center;
      margin-top: 10px;
    }

    .barcode img {
      display: block;
      width: 100%;
      height: 80px;
      object-fit: fill;
    }

    .center {
      text-align: center;
    }

    .small {
      font-size: 10px;
    }

    .address-line,
    .item-line {
      overflow-wrap: anywhere;
    }

    .item {
      margin-bottom: 6px;
    }

    .more-items {
      font-size: 10px;
      font-weight: bold;
    }
  </style>
</head>
<body>
  <% labels.forEach((label) => { %>
    <div class="label">
      <div class="section">
        <div class="bold">FROM</div>
        <div><%= label.seller.name %></div>
        <div><%= label.seller.stateName %> (<%= label.seller.stateCode %>)</div>
      </div>

      <div class="section">
        <div class="bold">TO</div>
        <div class="name"><%= label.order.customerName %></div>

        <div class="address-line"><%= label.order.addressLine1 %></div>
        <% if (label.order.addressLine2) { %>
          <div class="address-line"><%= label.order.addressLine2 %></div>
        <% } %>
        <div class="address-line"><%= label.order.city %></div>

        <div class="bold"><%= label.order.stateName %> (<%= label.order.stateCode %>)</div>

        <div class="pincode">PINCODE: <%= label.order.pincode %></div>

        <div>Phone: <%= label.order.phone %></div>
      </div>

      <div class="section">
        <div>ORDER ID: <%= label.order.orderId %></div>
        <div>ORDER DATE: <%= label.order.date %></div>
        <div class="bold">
          PAYMENT:
          <% if (label.order.isCOD) { %>
            COD ₹<%= label.order.codAmount %>
          <% } else { %>
            PREPAID
          <% } %>
        </div>
      </div>

      <div class="section">
        <div class="bold">ITEMS:</div>
        <% label.items.forEach((item) => { %>
          <div class="item">
            <div class="item-line"><%= item.name %></div>
            <% if (item.sku) { %>
              <div>SKU: <%= item.sku %></div>
            <% } %>
            <div>Qty: <%= item.quantity %></div>
          </div>
        <% }) %>
        <% if (label.remainingItemCount > 0) { %>
          <div class="more-items">+ <%= label.remainingItemCount %> more item line(s)</div>
        <% } %>
      </div>

      <div class="section barcode">
        <img src="<%= label.barcode %>" alt="Code 128 barcode for <%= label.order.orderId %>" />
        <div class="center"><%= label.order.orderId %></div>
      </div>

      <div class="section small center">
        DO NOT FOLD BARCODE
      </div>
    </div>
  <% }) %>
</body>
</html>
