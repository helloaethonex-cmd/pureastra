<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>How Was Your Order?</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:4px;overflow:hidden;max-width:600px;">

          <!-- Header -->
          <tr>
            <td style="background:#1a1a1a;padding:32px 40px;">
              <p style="margin:0;font-size:20px;font-weight:700;letter-spacing:4px;color:#ffffff;text-transform:uppercase;">PUREASTRA</p>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding:40px 40px 24px;text-align:center;">
              <p style="margin:0 0 8px;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#999;font-weight:600;">Order <%= orderNumber %></p>
              <h1 style="margin:0 0 16px;font-size:26px;font-weight:700;color:#1a1a1a;line-height:1.2;">How did we do, <%= customerName.split(' ')[0] %>?</h1>
              <p style="margin:0;font-size:14px;color:#666;line-height:1.7;">Your order has been delivered. We'd love to hear what you think — it takes less than a minute.</p>
            </td>
          </tr>

          <!-- Items -->
          <% if (items && items.length > 0) { %>
          <tr>
            <td style="padding:0 40px 32px;">
              <p style="margin:0 0 14px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#aaa;font-weight:600;text-align:center;">Your Order Included</p>
              <table width="100%" cellpadding="0" cellspacing="0">
                <% items.forEach(function(item) { %>
                <tr>
                  <td style="padding:9px 0;border-bottom:1px solid #f0f0f0;text-align:center;">
                    <p style="margin:0;font-size:13px;font-weight:600;color:#1a1a1a;"><%= item.productName %></p>
                    <% if (item.variantName) { %>
                    <p style="margin:3px 0 0;font-size:11px;color:#888;"><%= item.variantName %></p>
                    <% } %>
                  </td>
                </tr>
                <% }); %>
              </table>
            </td>
          </tr>
          <% } %>

          <!-- CTA -->
          <tr>
            <td style="padding:8px 40px 48px;text-align:center;">
              <a href="<%= feedbackUrl %>" style="display:inline-block;padding:16px 52px;background:#1a1a1a;color:#ffffff;text-decoration:none;font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;border-radius:2px;">Leave a Review</a>
              <p style="margin:16px 0 0;font-size:11px;color:#bbb;">This link is personal to your order and expires in 30 days.</p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 40px;border-top:1px solid #f0f0f0;text-align:center;">
              <p style="margin:0;font-size:11px;color:#bbb;line-height:1.6;">This is a transactional email from PureAstra. Please do not reply.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
