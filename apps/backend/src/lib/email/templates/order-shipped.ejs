<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Your Order Has Shipped</title>
</head>
<body style="margin:0;padding:0;background:#f4f4f4;font-family:'Segoe UI',Arial,sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f4f4f4;padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:4px;overflow:hidden;max-width:600px;">

          <!-- Header -->
          <tr>
            <td style="background:#1a1a1a;padding:32px 40px;">
              <p style="margin:0;font-size:20px;font-weight:700;letter-spacing:4px;color:#ffffff;text-transform:uppercase;">PUREASTRA</p>
            </td>
          </tr>

          <!-- Hero -->
          <tr>
            <td style="padding:40px 40px 24px;">
              <p style="margin:0 0 8px;font-size:10px;text-transform:uppercase;letter-spacing:1.5px;color:#999;font-weight:600;">On Its Way</p>
              <h1 style="margin:0 0 16px;font-size:26px;font-weight:700;color:#1a1a1a;line-height:1.2;">Your order has shipped, <%= customerName.split(' ')[0] %>.</h1>
              <p style="margin:0;font-size:14px;color:#666;line-height:1.7;">Great news — your PureAstra order is on its way. We'll let you know once it's delivered.</p>
            </td>
          </tr>

          <!-- Order Meta -->
          <tr>
            <td style="padding:0 40px 32px;">
              <table width="100%" cellpadding="0" cellspacing="0" style="background:#f9f9f9;border-radius:4px;">
                <tr>
                  <td style="padding:16px 20px;">
                    <p style="margin:0 0 4px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#aaa;font-weight:600;">Order Number</p>
                    <p style="margin:0;font-size:16px;font-weight:700;color:#1a1a1a;"><%= orderNumber %></p>
                  </td>
                  <td style="padding:16px 20px;text-align:right;">
                    <p style="margin:0 0 4px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#aaa;font-weight:600;">Shipped</p>
                    <p style="margin:0;font-size:13px;color:#444;"><%= shippedAt %></p>
                  </td>
                </tr>
              </table>
            </td>
          </tr>

          <!-- Shipping Address -->
          <tr>
            <td style="padding:0 40px 32px;">
              <p style="margin:0 0 12px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#aaa;font-weight:600;">Delivering To</p>
              <p style="margin:0;font-size:13px;font-weight:600;color:#1a1a1a;"><%= shippingAddress.name %></p>
              <p style="margin:6px 0 0;font-size:12px;color:#666;line-height:1.8;">
                <%= shippingAddress.line1 %><% if (shippingAddress.line2) { %>, <%= shippingAddress.line2 %><% } %><br/>
                <%= shippingAddress.city %>, <%= shippingAddress.state %> &mdash; <%= shippingAddress.postalCode %><br/>
                <%= shippingAddress.country %>
              </p>
            </td>
          </tr>

          <!-- Items -->
          <tr>
            <td style="padding:0 40px 32px;">
              <p style="margin:0 0 14px;font-size:10px;text-transform:uppercase;letter-spacing:1px;color:#aaa;font-weight:600;">Items Shipped</p>
              <table width="100%" cellpadding="0" cellspacing="0">
                <% items.forEach(function(item) { %>
                <tr>
                  <td style="padding:9px 0;border-bottom:1px solid #f0f0f0;">
                    <p style="margin:0;font-size:13px;font-weight:600;color:#1a1a1a;"><%= item.productName %></p>
                    <% if (item.variantName) { %>
                    <p style="margin:3px 0 0;font-size:11px;color:#888;"><%= item.variantName %></p>
                    <% } %>
                    <p style="margin:3px 0 0;font-size:11px;color:#aaa;">Qty: <%= item.quantity %></p>
                  </td>
                </tr>
                <% }); %>
              </table>
            </td>
          </tr>

          <!-- Track CTA (optional) -->
          <% if (trackingUrl) { %>
          <tr>
            <td style="padding:0 40px 40px;text-align:center;">
              <a href="<%= trackingUrl %>" style="display:inline-block;padding:14px 44px;background:#1a1a1a;color:#ffffff;text-decoration:none;font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;border-radius:2px;">Track Your Order</a>
            </td>
          </tr>
          <% } %>

          <!-- Footer -->
          <tr>
            <td style="padding:24px 40px;border-top:1px solid #f0f0f0;text-align:center;">
              <p style="margin:0;font-size:11px;color:#bbb;line-height:1.6;">This is a transactional email from PureAstra. Please do not reply.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
